  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skill",
    "skills",
    "egm",
    "elephant-goldfish",
    "spec-driven-development",
    "design-review",
    "goldfish",
    "dsh-plugin",
    "deepseek",
    "dsh-ops-compatible",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "author": "dryw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dryw/dsh-egm.git"
