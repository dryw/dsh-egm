{
  "name": "dsh-egm",
  "version": "0.3.0",
  "description": "Elephant-Goldfish Model (EGM) for DeepSeek Harness: brainstorm with a context-rich Elephant, draft a design document, and stress-test it with fresh-context Goldfish reviewers before implementation.",
  "type": "module",
  "main": "adapters/dsh/skills-host.js",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "check:upstream": "node adapters/dsh/check_upstream.mjs"
  },
  "exports": {
    ".": "./adapters/dsh/skills-host.js",
    "./skills-host": "./adapters/dsh/skills-host.js",
    "./reviewer-host": "./adapters/dsh/reviewer-host.js",
    "./reviewer-tools": "./adapters/dsh/reviewer-tools.js",
    "./locale/*.json": "./adapters/dsh/locale/*.json",
    "./icon": "./adapters/dsh/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "skills/egm-bootstrap/SKILL.md",
    "skills/egm-bootstrap/references/templates.md",
    "skills/egm-bootstrap/references/worker-return.schema.json",
    "skills/egm-brainstorm/SKILL.md",
